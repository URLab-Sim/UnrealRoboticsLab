<mujoco model="angle_degrees">
<!-- degree-mode compiler, joint range/ref/springref, and body poses via euler and axisangle -->
  <compiler angle="degree" eulerseq="zyx"/>

  <worldbody>
    <body name="body_euler" pos="0 0 1" euler="30 45 60">
      <joint name="j_euler" type="hinge" axis="0 0 1" range="-90 90" ref="15" springref="30" stiffness="1"/>
      <geom name="geom_euler" type="box" size="0.1 0.1 0.1"/>
      <body name="body_axisangle" pos="0.5 0 0" axisangle="0 0 1 90">
        <joint name="j_axisangle" type="hinge" axis="1 0 0" range="-45 45" ref="10" springref="20" stiffness="1"/>
        <geom name="geom_axisangle" type="box" size="0.05 0.05 0.05"/>
      </body>
    </body>
  </worldbody>
</mujoco>
